# sync-daemon-server configuration
# Copy this file to "server.conf" next to sync-daemon-server.sh and edit it.
#
# This package is self-contained on purpose: everything it needs (this config,
# its logs, its PID file) lives inside its own install folder. Put that folder
# on a persistent data volume (e.g. /volume1/Varie/sync-daemon/) -- on
# Synology DSM and QNAP QTS, /etc and /root are reset or not guaranteed to
# survive firmware updates, but volumes under /volume1 (or /share on QNAP) are.

# --- The NASBox folder itself (same as remote_prefix in the client) ---
# Every client mirrors this one folder, root to root -- there is no per-user
# or per-folder subpath under it to configure.
SHARE_ROOT=/volume1/NASBox

# The installer creates SHARE_ROOT/.nasbox-root. Do not remove it: clients
# refuse destructive synchronization when the repository marker is missing.

# --- History/trash retention, in days, for SHARE_ROOT/.sync-trash ---
# Examples: 30 (one month), 365 (one year), 0 (disabled -- never auto-prune)
RETENTION_DAYS=90

# --- History size limit for SHARE_ROOT/.sync-trash, in megabytes ---
# 0 = no limit (only RETENTION_DAYS applies). Above the limit the oldest
# versions are removed first, but never versions younger than
# TRASH_MIN_KEEP_DAYS. Example: TRASH_MAX_MB=51200 (50 GB).
TRASH_MAX_MB=0
TRASH_MIN_KEEP_DAYS=7

# --- How often the daemon itself wakes up to check/prune, in minutes ---
# The daemon is a single always-running process with its own internal timer --
# no cron/Task Scheduler involved. This just controls that internal sleep.
# Recommended: 720 (12 hours) or 1440 (24 hours) to allow HDD disk spindown / hibernation
# on low-power NAS devices without unnecessary disk spin-ups every hour.
CHECK_INTERVAL_MINUTES=720

# --- Limit each pruning pass so a large history does not monopolize sync ---
# Older versions continue at the next CHECK_INTERVAL_MINUTES pass.
PRUNE_MAX_FILES_PER_PASS=500

# --- Abandoned private staging retention ---
# A staging batch older than this is removed only during a pruning pass and
# only when no recoverable transaction references it.
STAGING_RETENTION_HOURS=168
PRUNE_MAX_STAGING_PER_PASS=20

# --- Housekeeping ---
LOG_MAX_BYTES=5242880       # rotate server.log past this size (bytes)
LOG_RETENTION_DAYS=30       # delete server.log.1/events.jsonl.1 after N days (0 = keep)
EVENTS_MAX_BYTES=5242880    # rotate events.jsonl past this size (bytes)
JOURNAL_MAX_BYTES=10485760  # compact the transfer journal past this size (bytes)
JOURNAL_MAX_LINES=50000     # ...or past this many lines
STATE_TEMP_MAX_AGE_HOURS=24 # remove stale temporary files after N hours (0 = keep)

# --- Capabilities ---
# How many files --file-states reads and hashes at once. Empty (recommended)
# means one per CPU core, at most 8: a 4-core NAS uses 4, a 2-core NAS uses 2
# instead of the fixed 8 that used to thrash a small CPU and a single disk.
# Set it only to force a value (1..64).
# FILE_STATES_PARALLELISM=

# --- Web UI (consultazione e caricamento da browser) ---
# Il demone la avvia da solo se WEB_LISTEN è impostato; "--web [indirizzo]" la
# avvia a mano. Senza WEB_PASSWORD è di sola lettura e ascolta solo su loopback:
# per ascoltare sulla LAN o fuori casa la password è obbligatoria, e per l'uso
# fuori casa servono HTTPS (WEB_TLS_*) o, meglio, un reverse proxy / VPN.
# I caricamenti passano dal journal come quelli dei PC e non sovrascrivono mai
# un file esistente ("nota (1).txt").
# WEB_LISTEN=0.0.0.0:8080
# WEB_USER=andrea
# WEB_PASSWORD=scegli-una-password-lunga
# WEB_MAX_UPLOAD_MB=4096          # dimensione massima per richiesta
# WEB_TLS_CERT=/percorso/cert.pem
# WEB_TLS_KEY=/percorso/chiave.pem

# --- Manutenzione del demone Go (passo di --run-once) ---
# CHUNK_GC=true               GC dei chunk non più referenziati (false = spenta)
# CHUNK_GC_GRACE_HOURS=24     periodo di grazia prima di rimuovere un chunk
# CHUNK_FSCK_DAYS=7           ogni quanti giorni rileggere e verificare tutti i chunk (0 = mai)
# STATE_BACKUP_KEEP=7         copie giornaliere di journal e manifest in state/backup (0 = nessuna)
# AUDIT_AUTO=report           report (solo segnala) | adopt (adotta i file orfani) | off
#                             Le righe "fantasma" non si dimenticano mai da sole.

# --- Notifiche (compatibili con ntfy: POST di testo con header Title) ---
# I messaggi contengono solo conteggi, mai nomi di file; uno per tipo ogni NOTIFY_MIN_HOURS.
# Avvisi: disco oltre la soglia, problemi di integrità dei chunk, manifest/disco non coerenti.
# NOTIFY_URL=https://ntfy.sh/un-argomento-lungo-e-segreto
# NOTIFY_DISK_PERCENT=90
# NOTIFY_MIN_HOURS=24
